# Confidence — .gitignore

# ─── Secrets — never commit these ─────────────────────────────────────────────
.env.local
.env
.env.*.local

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Uploads / temp files ─────────────────────────────────────────────────────
uploads/
tmp/
*.tmp

# ─── Render ───────────────────────────────────────────────────────────────────
.render-buildpacks.json

.agents/
skills-lock.json
.claude/

# ─── AI-assistant planning docs (internal, keep out of repo listing) ──────────
CLAUDE.md
CLAUDE_PROJECT.md
PLANNING.md
STACK.md
DEPLOY.md
VERTICAL.md
INTERVIEW.md

# Frontend
frontend/node_modules/
frontend/dist/

.vercel
.env*
!.env.example

# Logs
*.log
